# Copy to .env and fill in local/deployment-specific values. Never commit .env.
DATABASE_URL=postgres://YOUR_LOCAL_USER:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/gymmane
AUTH_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
HOST=127.0.0.1
PORT=8080
# HTTP auth only for localhost deterministic development JWKS servers.
ALLOW_LOCAL_AUTH=false
# Comma-separated exact web origins; empty denies browser cross-origin requests.
CORS_ALLOWED_ORIGINS=
